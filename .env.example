# Salin ke .env.local bila API tidak berjalan di http://localhost:8000.
# Kosongkan nilainya (NEXT_PUBLIC_API_BASE_URL=) bila portal dan API
# disajikan dari domain yang sama di balik Caddy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Alamat API dari sisi SERVER portal, untuk memeriksa kunci sematan situs lain
# (src/proxy.ts). Dibaca saat server berjalan, bukan saat build. Kosong = pakai
# NEXT_PUBLIC_API_BASE_URL bila berupa alamat lengkap, atau http://localhost:8000.
# Wajib diisi bila NEXT_PUBLIC_API_BASE_URL dikosongkan, atau bila alamat itu
# tidak terjangkau dari mesin/kontainer portal.
#
# Situs yang boleh memasang asisten tidak lagi diatur di sini: setiap situs
# mendapat kunci sendiri dari halaman Sematan di dashboard admin.
API_INTERNAL_URL=

# Salin ke .env.local bila API tidak berjalan di http://localhost:8000.
# Kosongkan nilainya (NEXT_PUBLIC_API_BASE_URL=) bila portal dan API
# disajikan dari domain yang sama di balik Caddy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Situs lain yang boleh memasang asisten lewat
#   <script src="https://<domain-portal>/embed.js" async></script>
# Dipisah koma. Kosong = situs mana pun -- isi di produksi, karena setiap
# pertanyaan dari situs penyemat memakai kuota model AI kampus.
# Dibaca saat `npm run build`: mengubahnya berarti build ulang.
EMBED_ALLOWED_ORIGINS=
